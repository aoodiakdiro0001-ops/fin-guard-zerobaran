# ── Fin-Guard ZeroBaran ─ ملف البيئة (كل المفاتيح اختيارية) ─────────────
# انسخ هذا الملف إلى `.env` وضع قيماً فقط لما تحتاجه، أو اتركه كما هو
# ويعمل النظام بالمحرّك المحلي الحتمي بالكامل.

# ① العقل المحاسبي الذكي (اختياري — أي واحد يكفي)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama محلي اختياري — فعّله بإزالة علامة # فقط إذا كان مثبّتاً لديك
# OLLAMA_URL=http://localhost:11434

# ② قاعدة البيانات السحابية (اختياري — السجل المحلي يعمل بلا إنترنت)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ③ تنبيهات تليجرام الفورية (اختياري)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ④ إعدادات مالية
# العملة الأساسية التي تُجمَّع بها الإجماليات (USD, TRY, EUR, …)
BASE_CURRENCY=USD
# الميزانية الشهرية الإجمالية — أو استخدم budget.json لميزانية لكل فئة
BUDGET_MONTHLY=
# نسبة الضريبة الافتراضية المستخدمة في التقديرات (مثل 20 أو 10)
TAX_RATE=
# أسعار صرف إلى العملة الأساسية بصيغة JSON — تُدمج بها العملات الأخرى
# مثال: {"TRY": 0.03, "EUR": 1.08}
EXCHANGE_RATES=
# مجلد استقبال الفواتير الافتراضي
INBOX_DIR=finance/inbox
